[Unit]
Description=Mphondo GitHub Webhook Listener
After=network.target docker.service mnt-data.mount
Wants=docker.service
RequiresMountsFor=/mnt/data

[Service]
Type=simple
User=claude
Group=claude
WorkingDirectory=/mnt/data/projects/mphondo/src/infra/webhook
ExecStart=/usr/bin/python3 /mnt/data/projects/mphondo/src/infra/webhook/webhook.py
Restart=on-failure
RestartSec=5s

EnvironmentFile=/mnt/data/projects/mphondo/infra/.env.webhook
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mphondo-webhook

# Seguridad básica
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
