# =============================================================
# Mphondo v3 — Variables de entorno
# =============================================================
# 1. Copia este archivo:  cp .env.example .env
# 2. Rellena TODOS los valores marcados con <CAMBIAR>
# 3. NUNCA subas .env al repositorio (está en .gitignore)
# =============================================================

# ---  PostgreSQL  ---
POSTGRES_DB=mphondo
POSTGRES_USER=mphondo
POSTGRES_PASSWORD=<CAMBIAR_contraseña_segura_32chars>

# ---  Redis  ---
REDIS_PASSWORD=<CAMBIAR_contraseña_segura_24chars>

# ---  FastAPI  ---
SECRET_KEY=<CAMBIAR_64_chars_aleatorios>          # python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=<CAMBIAR_32_chars_para_pgcrypto>   # para cifrar tokens de Enable Banking en BD
ENVIRONMENT=production
LOG_LEVEL=info

# ---  Supabase  ---
SUPABASE_URL=https://<TU_HOST_TAILSCALE>/supabase
SUPABASE_ANON_KEY=<CAMBIAR_anon_key_supabase>
SUPABASE_SERVICE_KEY=<CAMBIAR_service_role_key_supabase>
SUPABASE_JWT_SECRET=<CAMBIAR_jwt_secret_32chars_minimo>
SITE_URL=https://<TU_HOST_TAILSCALE>
ADDITIONAL_REDIRECT_URLS=

# ---  SMTP (para emails de auth Supabase)  ---
# Opción gratuita: Brevo (antiguo Sendinblue), 300 emails/día gratis
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=<TU_EMAIL_BREVO>
SMTP_PASS=<CAMBIAR_smtp_key_brevo>
SMTP_SENDER_NAME=Mphondo
MAILER_AUTOCONFIRM=false

# ---  Caddy  ---
CADDY_HOST=<TU_NODO>.tail<NUMERO>.ts.net         # hostname Tailscale MagicDNS
API_UPSTREAM=mphondo-api:8000
SUPABASE_UPSTREAM=mphondo-supabase-kong:8000
GRAFANA_UPSTREAM=mphondo-grafana:3000
# ACME_EMAIL=<TU_EMAIL>                           # sólo si usas dominio público

# ---  APIs externas  ---
FX_API_KEY=                                       # exchangerate.host — gratis sin key
ENABLE_BANKING_CLIENT_ID=<CAMBIAR_si_usas_PSD2>
ENABLE_BANKING_CLIENT_SECRET=<CAMBIAR_si_usas_PSD2>

# ---  Notificaciones push (ntfy.sh)  ---
NTFY_URL=https://ntfy.sh                          # o tu instancia self-hosted
NTFY_TOPIC=<CAMBIAR_topic_secreto_unico>

# ---  GitHub Container Registry (para Watchtower)  ---
GITHUB_ACTOR=<TU_USUARIO_GITHUB>
GITHUB_REPOSITORY=<TU_USUARIO>/mphondo
GHCR_TOKEN=<CAMBIAR_ghcr_pat_read_packages>
API_TAG=stable

# ---  Grafana  ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=<CAMBIAR_contraseña_grafana>
GRAFANA_URL=https://<TU_HOST_TAILSCALE>/grafana
